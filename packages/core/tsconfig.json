{
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM gives the types of fetch, AbortSignal, TextDecoder and the timers, which Node, a browser and
    // React Native all have. The code uses no document.
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // No Node API: the relay and the mobile app run this code too. Only the tests load the types of Node.
    "types": []
  }
}
