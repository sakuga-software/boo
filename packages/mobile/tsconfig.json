{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The app runs in React Native: no type of Node. Only the tests load them (tsconfig.test.json).
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "ios", "android"]
}
