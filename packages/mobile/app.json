{
  "expo": {
    "name": "boo",
    "slug": "boo",
    "owner": "sakuga-software",
    "version": "0.1.0",
    "scheme": "boo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "dev.sakuga.boo",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "669547726G"
    },
    "android": {
      "package": "dev.sakuga.boo",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png",
        "backgroundColor": "#120F18"
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "relayUrl": "https://boo-relay.sakuga.dev",
      "router": {},
      "eas": {
        "projectId": "c99df17f-1fdf-424f-b5bf-731bd1b0d36d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c99df17f-1fdf-424f-b5bf-731bd1b0d36d"
    }
  }
}
