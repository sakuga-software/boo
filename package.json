{
  "name": "boo-workspace",
  "private": true,
  "description": "The workspace of boo: the CLI in packages/cli.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky && pnpm --filter @sakuga-software/boo build",
    "build": "pnpm --filter @sakuga-software/boo build",
    "dev": "pnpm --filter @sakuga-software/boo dev",
    "typecheck": "pnpm --filter @sakuga-software/boo typecheck",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "pnpm --filter @sakuga-software/boo test",
    "test:coverage": "pnpm --filter @sakuga-software/boo test:coverage",
    "check:pack": "pnpm --filter @sakuga-software/boo check:pack",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:coverage && pnpm check:pack",
    "demo": "pnpm --filter @sakuga-software/boo demo"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}
