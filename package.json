{
  "name": "@sakuga-software/boo",
  "version": "1.0.0",
  "description": "Watches your open pull requests: the approval, the reviewers of every provider, the checks, and the review quotas",
  "keywords": [
    "claude-code",
    "cli",
    "code-review",
    "coderabbit",
    "github",
    "pull-requests",
    "tui"
  ],
  "homepage": "https://github.com/sakuga-software/boo#readme",
  "bugs": {
    "url": "https://github.com/sakuga-software/boo/issues"
  },
  "license": "MIT",
  "author": "Sakuga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakuga-software/boo.git"
  },
  "bin": {
    "boo": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepare": "pnpm build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p demo/tsconfig.json",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "tsx --test src/*.test.ts",
    "demo": "tsx --tsconfig demo/tsconfig.json demo/demo.tsx"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "meow": "^14.1.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}
